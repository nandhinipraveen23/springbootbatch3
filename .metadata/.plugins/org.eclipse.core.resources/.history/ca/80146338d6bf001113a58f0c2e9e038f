package com.example.demo.scheduler;

import java.time.LocalDate;
import java.time.Period;
import java.util.List;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.scheduling.annotation.Scheduled;
import org.springframework.stereotype.Component;

import com.example.demo.entity.Employee;
import com.example.demo.notification.EmailService;
import com.example.demo.repository.EmployeeRepository;

@Component
public class EmployeeScheduler {

    @Autowired
    private EmployeeRepository employeeRepository;

    @Autowired
    private EmailService emailService;


    // Runs every day at 9:00 AM
    @Scheduled(
        cron = "0 0 9 * * *",
        zone = "Asia/Kolkata"
    )
    public void checkBirthdays() {

        LocalDate today = LocalDate.now();

        System.out.println(
            "Checking birthdays for: " + today
        );

        List<Employee> employees =
                employeeRepository.findAll();

        for (Employee emp : employees) {

            if (emp.getDob() == null) {
                continue;
            }

            if (emp.getDob().getMonthValue()
                    == today.getMonthValue()
                &&
                emp.getDob().getDayOfMonth()
                    == today.getDayOfMonth()) {

                System.out.println(
                    "🎂 TODAY'S BIRTHDAY: "
                    + emp.getEmpName()
                    + " | "
                    + emp.getEmail()
                );

                String subject =
                        "Happy Birthday " + emp.getEmpName();

                String body =
                        "Dear " + emp.getEmpName() + ",\n\n"
                        + "Wishing you a very Happy Birthday! 🎂\n"
                        + "Have a wonderful and successful year ahead.\n\n"
                        + "Regards,\n"
                        + "HR Team";

                emailService.sendEmail(
                        emp.getEmail(),
                        subject,
                        body
                );
            }
        }
    }
}