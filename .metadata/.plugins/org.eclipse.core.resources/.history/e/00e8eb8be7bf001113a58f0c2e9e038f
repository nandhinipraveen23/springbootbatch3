package com.example.demo.scheduler;

import java.time.LocalDate;
import java.time.Period;
import java.util.List;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.beans.factory.annotation.Value;
import org.springframework.scheduling.annotation.Scheduled;
import org.springframework.stereotype.Component;

import com.example.demo.entity.Employee;
import com.example.demo.notification.EmailService;
import com.example.demo.repository.EmployeeRepository;


@Component
public class EmployeeScheduler {

    @Autowired
    private EmployeeRepository employeeRepository;

    @Autowired
    private EmailService emailService;

    @Value("${festival.diwali}")
    private LocalDate diwaliDate;


    // ==========================================
    // BIRTHDAY
    // ==========================================

    @Scheduled(
        cron = "0 0 9 * * *",
        zone = "Asia/Kolkata"
    )
//    @Scheduled(fixedRate = 30000)
    public void checkBirthdays() {

        LocalDate today = LocalDate.now();

        System.out.println(
            "Checking birthdays: " + today
        );

        List<Employee> employees =
                employeeRepository.findAll();

        for (Employee emp : employees) {

            if (emp.getDob() == null) {
                continue;
            }

            if (emp.getDob().getMonthValue()
                    == today.getMonthValue()
                &&
                emp.getDob().getDayOfMonth()
                    == today.getDayOfMonth()) {

                System.out.println(
                    "🎂 TODAY'S BIRTHDAY: "
                    + emp.getEmpName()
                );

                String subject =
                        "Happy Birthday " +
                        emp.getEmpName();

                String body =
                        "Dear " + emp.getEmpName() + ",\n\n"
                        + "Wishing you a very Happy Birthday! 🎂\n"
                        + "Have a wonderful year ahead.\n\n"
                        + "Regards,\n"
                        + "HR Team";

                emailService.sendEmail(
                        emp.getEmail(),
                        subject,
                        body
                );
            }
        }
    }


    // ==========================================
    // WORK ANNIVERSARY
    // ==========================================

    @Scheduled(
        cron = "0 5 9 * * *",
        zone = "Asia/Kolkata"
    )
    public void checkWorkAnniversaries() {

        LocalDate today = LocalDate.now();

        System.out.println(
            "Checking work anniversaries: " + today
        );

        List<Employee> employees =
                employeeRepository.findAll();

        for (Employee emp : employees) {

            if (emp.getDoj() == null) {
                continue;
            }

            if (emp.getDoj().getMonthValue()
                    == today.getMonthValue()
                &&
                emp.getDoj().getDayOfMonth()
                    == today.getDayOfMonth()) {

                int years =
                        Period.between(
                            emp.getDoj(),
                            today
                        ).getYears();

                System.out.println(
                    "🎉 "
                    + emp.getEmpName()
                    + " completed "
                    + years
                    + " years."
                );

                String subject =
                        "Happy Work Anniversary " +
                        emp.getEmpName();

                String body =
                        "Dear " + emp.getEmpName() + ",\n\n"
                        + "Congratulations on completing "
                        + years
                        + " years with our organization! 🎉\n\n"
                        + "Thank you for your valuable contribution.\n\n"
                        + "Regards,\n"
                        + "HR Team";

                emailService.sendEmail(
                        emp.getEmail(),
                        subject,
                        body
                );
            }
        }
    }


    // ==========================================
    // DIWALI
    // ==========================================

    @Scheduled(
        cron = "0 0 10 * * *",
        zone = "Asia/Kolkata"
    )
    public void sendDiwaliWishes() {

        LocalDate today = LocalDate.now();

        if (!today.equals(diwaliDate)) {
            return;
        }

        System.out.println(
            "🪔 Sending Diwali wishes..."
        );

        List<Employee> employees =
                employeeRepository.findAll();

        for (Employee emp : employees) {

            if (emp.getEmail() == null) {
                continue;
            }

            String subject =
                    "Happy Diwali " +
                    emp.getEmpName() + " 🪔";

            String body =
                    "Dear " + emp.getEmpName() + ",\n\n"
                    + "Wishing you and your family a very Happy Diwali! 🪔\n"
                    + "May this festival of lights bring happiness,\n"
                    + "success and prosperity to you and your family.\n\n"
                    + "Regards,\n"
                    + "HR Team";

            emailService.sendEmail(
            		"nandhinipraveen@gmail.com",
                    emp.getEmail(),
                    subject,
                    body
            );
        }
    }


    // ==========================================
    // CHRISTMAS
    // ==========================================

    @Scheduled(
        cron = "0 0 10 * * *",
        zone = "Asia/Kolkata"
    )
    public void sendChristmasWishes() {

        LocalDate today = LocalDate.now();

        if (today.getMonthValue() != 12
                || today.getDayOfMonth() != 25) {

            return;
        }

        System.out.println(
            "🎄 Sending Christmas wishes..."
        );

        List<Employee> employees =
                employeeRepository.findAll();

        for (Employee emp : employees) {

            if (emp.getEmail() == null) {
                continue;
            }

            String subject =
                    "Merry Christmas " +
                    emp.getEmpName() + " 🎄";

            String body =
                    "Dear " + emp.getEmpName() + ",\n\n"
                    + "Wishing you and your family a very Merry Christmas! 🎄\n"
                    + "May your Christmas be filled with happiness,\n"
                    + "peace and joy.\n\n"
                    + "Regards,\n"
                    + "HR Team";

            emailService.sendEmail(
                    emp.getEmail(),
                    subject,
                    body
            );
        }
    }
}