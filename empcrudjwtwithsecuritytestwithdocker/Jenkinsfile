
pipeline {
    agent any

    stages {
        stage('Build') {
            steps {
                dir('empcrudjwtwithsecuritytestwithdocker') {
                    bat 'mvnw.cmd clean package -DskipTests'
                }
            }
        }

        stage('Docker Build') {
            steps {
                dir('empcrudjwtwithsecuritytestwithdocker') {
                    bat 'docker build -t emp-app2 .'
                }
            }
        }
    }
}
